platform :ios, '13.0'

target 'CloudXSwiftRemotePods' do
  use_frameworks! :linkage => :static

  pod 'CloudXCore', '~> 3.1.0'
  pod 'CloudXMetaAdapter', '~> 3.1.0'
  pod 'CloudXRenderer', '~> 3.1.0'
  pod 'CloudXVungleAdapter', '~> 3.1.0'
  pod 'CloudXInMobiAdapter', '~> 3.1.0'
  pod 'CloudXMintegralAdapter', '~> 3.1.0'
  pod 'CloudXUnityAdsAdapter', '~> 3.1.0'

  # Local QA harness. Enabled only when CLX_QA_HARNESS=1 so normal dev/release
  # builds remain unchanged. DeepLinkRouter is guarded by
  # canImport(CloudXTestHarness) and falls back to no-op stubs when the harness
  # is absent.
  if ENV['CLX_QA_HARNESS'] == '1'
    pod 'CloudXTestHarness', :path => '../../cloudx-qa-automation/sdk/ios/CloudXTestHarness'
  end

  target 'CloudXSwiftRemotePodsTests' do
    inherit! :search_paths
  end
  target 'CloudXSwiftRemotePodsUITests' do
  end
end
