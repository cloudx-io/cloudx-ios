platform :ios, '15.0'
use_frameworks! :linkage => :static

target 'CloudXMintegralAdapter' do
  pod 'CloudXCore', :path => '../core'
  
  # Mintegral SDK with bidding support
  # Using updated SDK modules matching AppLovin adapter patterns
  pod 'MintegralAdSDK', '~> 8.0'
  
  # Banner ads (standard + bidding)
  pod 'MintegralAdSDK/BannerAd', '~> 8.0'
  
  # New Interstitial (standard + bidding) - uses MTGNewInterstitialBidAdManager
  pod 'MintegralAdSDK/BidInterstitialVideoAd', '~> 8.0'
  
  # Rewarded Video (standard + bidding) - uses MTGBidRewardAdManager singleton
  pod 'MintegralAdSDK/BidRewardVideoAd', '~> 8.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end

