platform :ios, '15.0'

target 'CloudXObjCRemotePods' do
  use_frameworks! :linkage => :static

  # Published CloudXCore binary, resolved through this repo's podspec (its vendored
  # xcframework path is repo-root-relative, so a bare :path => '../core' resolves to
  # core/core/… and yields an empty pod).
  pod 'CloudXCore', :podspec => '../core/CloudXCore.podspec'
  pod 'CloudXMetaAdapter', '~> 6.22.1.0'
  pod 'CloudXVungleAdapter', '~> 7.7.8.0'
  pod 'CloudXInMobiAdapter', '~> 11.4.1.1'
  pod 'CloudXMintegralAdapter', '~> 8.1.6.1'
  pod 'CloudXUnityAdsAdapter', '~> 4.21.0.0'
  pod 'CloudXMagniteAdapterV2', '~> 1.0.4.1'
  pod 'CloudXMolocoAdapter', '~> 4.11.1.1'
  pod 'CloudXVerveAdapter', '~> 3.9.3.0'
  pod 'CloudXDigitalTurbineAdapter', '~> 8.5.1.0'
  pod 'CloudXGoogleWaterfallAdapter', '~> 13.11.0.0'
  pod 'CloudXPangleAdapter', '~> 8.3.0.9.0'
  pod 'CloudXMobileFuseAdapter', '~> 1.11.0.2'
  pod 'CloudXTaurusXAdapter', '~> 1.18.2.1'
  pod 'CloudXBigoAdapter', '~> 6.1.0.0'

  # The First Look flow calls Google Mobile Ads directly. CloudXGoogleWaterfallAdapter pins its version.
  pod 'Google-Mobile-Ads-SDK'

  target 'CloudXObjCRemotePodsTests' do
    inherit! :search_paths
  end
  target 'CloudXObjCRemotePodsUITests' do
  end
end
