source 'https://cdn.cocoapods.org/'

# Uncomment the next line to define a global platform for your project
platform :ios, '14.0'

target 'CloudXObjCRemotePods' do
  use_frameworks! :linkage => :static

  # Pods for CloudXObjCRemotePods
  # CloudXCore from remote public repo as binary xcframework (dynamic)
  pod 'CloudXCore', :git => 'https://github.com/cloudx-io/cloudx-ios.git', :tag => 'v1.2.0-core'
  # CloudXMetaAdapter from remote public repo as binary xcframework (static)
  pod 'CloudXMetaAdapter', :git => 'https://github.com/cloudx-io/cloudx-ios.git', :tag => 'v1.2.0-meta'

  target 'CloudXObjCRemotePodsTests' do
    inherit! :search_paths
    # Pods for testing
  end

  target 'CloudXObjCRemotePodsUITests' do
    # Pods for testing
  end

end
