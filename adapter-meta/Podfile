# Uncomment the next line to define a global platform for your project
platform :ios, '14.0'

target 'CloudXMetaAdapter' do
  # Use dynamic frameworks so FBAudienceNetwork is NOT embedded into our adapter
  # Our adapter will reference FBAudienceNetwork at runtime, not bundle it statically
  use_frameworks!

  # Pods for CloudXMetaAdapter
  # FBAudienceNetwork MUST remain as an external dependency per Meta's terms
  pod 'FBAudienceNetwork', '6.20.1'
  
  # Use local CloudXCore from the monorepo during build
  pod 'CloudXCore', :path => '../core'

  target 'CloudXMetaAdapterTests' do
    # Pods for testing
  end

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # Remove FBAudienceNetwork from being linked into our adapter
    # It must remain as an external runtime dependency
    if target.name == 'CloudXMetaAdapter'
      target.frameworks_build_phase.files.each do |file|
        if file.file_ref && file.file_ref.path && file.file_ref.path.include?('FBAudienceNetwork')
          puts "🔧 Removing FBAudienceNetwork from link phase (must be external dependency)"
          target.frameworks_build_phase.remove_file_reference(file.file_ref)
        end
      end
    end
  end
end
