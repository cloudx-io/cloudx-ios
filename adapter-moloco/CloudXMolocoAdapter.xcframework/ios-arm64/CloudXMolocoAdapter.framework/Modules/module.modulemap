framework module CloudXMolocoAdapter {
    umbrella header "CloudXMolocoAdapter.h"

    export *
    module * { export * }

    // Required Moloco SDK module (xcframework binary name is MolocoSDK)
    link framework "MolocoSDK"

    // Required frameworks
    link framework "Foundation"
    link framework "UIKit"
    link framework "WebKit"
    link framework "AVFoundation"
    link framework "AVKit"
    link framework "AdSupport"
    link framework "CoreGraphics"
    link framework "CoreLocation"
    link framework "CoreTelephony"
    link framework "SystemConfiguration"
    link framework "StoreKit"
}
